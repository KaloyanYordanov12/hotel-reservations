# Copy to .env and fill in real values. Never commit .env.
# All amounts in this system are EUR. There is no currency column.

DATABASE_URL=postgresql+psycopg://hotel:hotel@localhost:5432/hotel
TEST_DATABASE_URL=postgresql+psycopg://hotel:hotel@localhost:5432/hotel_test
SESSION_SECRET=replace-with-a-long-random-string
# Generate with: python scripts/hash_password.py
APP_PASSWORD_HASH=replace-with-an-argon2-or-bcrypt-hash
# MUST be True in production (served over HTTPS). False here because local dev
# and the test client run over plain HTTP, where a Secure cookie is never sent.
COOKIE_SECURE=False
