# Production EnvironmentFile template for hotel-reservations.service.
#
# On the VPS: copy to /etc/hotel-reservations/hotel-reservations.env, fill in the
# real values, then `chmod 600` and `chown root:root`. NEVER commit the real
# file; it holds the database password, the session secret, and the password
# hash. This template holds placeholders only.
#
# All amounts are EUR. This system uses NO AI APIs, so there is no API key here.

# Real DB password (set when you create the hotel role, see docs/deploy.md).
DATABASE_URL=postgresql+psycopg://hotel:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/hotel

# There is deliberately no TEST_DATABASE_URL here. It is test-only, and the test
# suite truncates tables, so it must never live on the production box.

# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# Generate: python scripts/hash_password.py   (bcrypt)
APP_PASSWORD_HASH=CHANGE_ME_BCRYPT_HASH

# MUST be True in production. Cloudflare terminates HTTPS and the tunnel reaches
# the app over loopback, but the browser still requires Secure to send the
# session cookie back. Do not set this False on the box.
COOKIE_SECURE=True
