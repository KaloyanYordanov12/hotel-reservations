# Production EnvironmentFile template for hotel-demo.service (the PUBLIC DEMO).
#
# On the VPS: copy to /etc/hotel-demo/hotel-demo.env, fill in the real values,
# then `chmod 600` and `chown hotel-demo:hotel-demo`. NEVER commit the real file.
# This template holds placeholders only.
#
# This env file is the ONLY thing that makes this deployment a demo. It points at
# a SEPARATE database (hotel_demo) as a RESTRICTED role, and it has no reference
# to and no credentials for the real hotel database. The demo app is therefore
# structurally incapable of reading or writing the real bookings.
#
# All amounts are EUR. This system uses NO AI APIs, so there is no API key here.

# Demo database ONLY, as the restricted runtime role hotel_demo_app. That role has
# read/write on the demo's rows but no DDL and no privileges on the real database.
# Migrations are NOT run with this role; they run separately as the postgres
# superuser (see docs/deploy-demo.md). Never the real `hotel` database.
DATABASE_URL=postgresql+psycopg://hotel_demo_app:CHANGE_ME_DEMO_DB_PASSWORD@127.0.0.1:5432/hotel_demo

# Turns the demo ON: auth is bypassed and the banner shows. This is fail-secure
# in app/config.py: only an explicit true value ("1"/"true"/"yes") disables the
# login wall. It belongs in THIS env file and must never appear in the real app's
# env. Unset anywhere else means auth stays fully required.
DEMO_MODE=1

# The demo frontend's own origin. The frontend is a separate Cloudflare Pages
# project served from a DIFFERENT origin than this backend (its *.pages.dev URL or
# its own custom domain), so its browser calls are cross-origin. Set this to that
# Pages origin and the backend allows it via CORS, in demo mode only. This is NOT
# the backend's own reservations-demo subdomain. Leave unset to grant no
# cross-origin access. Comma-separate if there is more than one origin.
DEMO_FRONTEND_ORIGIN=https://reservations-demo.pages.dev

# Still REQUIRED even though the demo has no login: app/config.py validates both
# at startup and refuses to boot on a placeholder, so generate real throwaway
# values. They are never used to log in while DEMO_MODE is on.
#
# Both values are SINGLE-QUOTED, and must stay quoted. A bcrypt hash contains
# $2b$12$..., and this file is read two ways with different quoting rules: systemd
# (EnvironmentFile=) takes each value literally, but the reset cron SOURCES it with
# bash (set -a && . this-file), and unquoted, bash would expand $2b and $12 as
# variables and silently mangle the hash. Single quotes stop bash expanding it;
# systemd strips the surrounding quotes and stores the literal value, so both
# readers agree. Paste real values BETWEEN the quotes, and single-quote any other
# value that contains a $ as well (for example a DB password with a $ in it).
# Generate: python3.13 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET='CHANGE_ME_LONG_RANDOM_SECRET'
# Generate: sudo -u hotel-demo /opt/hotel-demo/venv/bin/python scripts/hash_password.py
APP_PASSWORD_HASH='CHANGE_ME_BCRYPT_HASH'

# Harmless to leave True. In demo mode there is no login and so no session cookie
# is ever set, but True stays fail-secure and matches the real app.
COOKIE_SECURE=True

# Deliberately NO TEST_DATABASE_URL here. It is test-only and the test suite
# truncates tables, so it must never live on a box that serves real traffic.
